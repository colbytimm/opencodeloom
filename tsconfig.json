{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": "."
  },
  "include": [
    ".opencode/tool/**/*.ts",
    ".opencode/plugin/**/*.ts",
    "types/**/*.d.ts"
  ]
}
