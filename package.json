{
  "name": "opencodeloom-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Local tools and plugin for OpenCode Loom",
  "type": "module",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "echo 'No build step required'",
