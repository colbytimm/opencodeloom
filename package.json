    "test:integration": "vitest run --dir tests/integration"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^0.15.1",
    "zod": "^4.1.12"
  }
}
